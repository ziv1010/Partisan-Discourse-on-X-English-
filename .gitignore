# Repository policy
# Keep source code, notebooks, documentation, figures, and compact tables in Git.
# Keep heavyweight raw data, generated model artifacts, checkpoints, caches, and
# local runtime files out of GitHub.

# Python/runtime cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
*.cache

# Local environments and editor files
.Python
.env
.env.*
!.env.example
.venv/
venv/
env/
*.egg-info/
.eggs/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs, temporary files, and local run state
logs/
*.log
*.tmp
*.temp
*.bak
*_parallel_state/
**/*_parallel_state/

# Archives and large binary data containers
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.pkl
*.pickle
*.parquet
*.feather
*.h5
*.hdf5

# Model weights, adapters, checkpoints, and training outputs
*.pt
*.pth
*.bin
*.safetensors
*.state_dict
*.ckpt
*.onnx
*.model
lora_adaptor/
Additional_Steps/Translating/models/
codes/4_finetuning/**/bert_model/
codes/4_finetuning/**/roberta_model/
codes/4_finetuning/**/checkpoints/
codes/4_finetuning/**/models/
codes/4_finetuning/**/checkpoint-*/

